# Contact form email delivery (https://resend.com, free tier is enough).
# Without RESEND_API_KEY the form shows the fallback message with your email address.
RESEND_API_KEY=your_resend_api_key_here

# Where booking requests are delivered.
CONTACT_TO=neuaux.studio@gmail.com

# Sender shown in your inbox. Until you verify a domain in Resend, keep the default:
# it can only deliver to the email address that owns the Resend account.
CONTACT_FROM=neuaux.studio <onboarding@resend.dev>

# Public URL of the site, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://neuaux.studio
